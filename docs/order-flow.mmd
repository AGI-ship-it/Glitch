    Home -->|Continue| Gate
    Courts --> Book
    Book -->|Continue| Gate

    Gate -->|No| Login
    Gate -->|Yes| Cart
    Login -->|No account yet| Signup
    Login -->|Log in| Cart
    Signup -->|Create account| Cart

    Cart -->|Checkout| Checkout
    Cart -->|Timer runs out| Lapsed
    Lapsed --> Home

    Checkout -->|Save details| Waiver
    Waiver -->|Sign| Payment
    Payment --> Outcome

    Outcome -->|Approved| Confirmation
    Outcome -->|Failed| Cart
    Outcome -->|Cancelled| Cart
    Cart -->|Retry, waiver already signed| Payment

    Confirmation --> Bookings
    Bookings --> Detail
    Detail -->|Free until 24h before| Reschedule
    Detail -->|Free until 24h before| Cancel
    Reschedule --> Detail
    Cancel --> Cancelled
