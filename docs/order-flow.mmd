    Payment["Payment — /payment<br/>External: CCAvenue"]
    Outcome{"Gateway outcome"}
    Confirmation["Confirmation — /confirmation<br/>Booking reference + QR code"]

    Bookings["My bookings — /account/bookings"]
    Detail["Booking details — /account/bookings/:reference"]
    Reschedule["Reschedule — .../reschedule"]
    Cancel["Cancel — .../cancel"]
